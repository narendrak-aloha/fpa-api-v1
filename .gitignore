# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build output
*.egg-info/
build/
dist/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*
coverage.xml
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/

# Secrets and local environment (API keys, DB passwords)
.env
.env.*
!.env.example

# Runtime logs (audit output may contain request data)
logs/
*.log
*.jsonl

# AI assistant tooling and transcripts (kept locally, never committed)
.claude/
.mcp.json
.specstory/
.aider*
.cursor/
CLAUDE.local.md

# Editor / OS files
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Local assignment reviews and walkthroughs (retain files on disk)
/docs/assignment_reconciled.md
/docs/ASSIGNMENT_CHECKLIST.md
/docs/FINAL_CHECK.md
/docs/Done.md
/docs/MANUAL_TEST.md
/docs/DEMO_RUNBOOK.md
/docs/CODE_TOUR.md
