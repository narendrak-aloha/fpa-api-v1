# Copy to .env (or: make env). Gitignored — add every new key to this template too.
# API keys only; ports, names and passwords live in docker/docker-compose.yml.
# claude-api needs ANTHROPIC_API_KEY, gemini needs GOOGLE_API_KEY, claude-code
# needs neither (it uses the host's `claude` login).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# In Ask, choose Claude (API key) or Gemini (API key). Set the matching key
# above in the API .env, restart the API, and refresh the UI. Missing or blank
# keys show an error; credentials are never entered or returned in the browser.

# Optional default for requests that omit provider; existing default is claude-code.
# Choices: claude-code, codex, claude-api, gemini. The UI selection overrides it.
FPA_LLM_PROVIDER=claude-code
# Codex subscription: run `codex -c cli_auth_credentials_store='"file"' login`.
# No API key. Blank model uses the SDK default; home defaults to CODEX_HOME or ~/.codex.
FPA_CODEX_MODEL=
FPA_CODEX_HOME=

# Durable re-forecast. All optional; compose supplies working defaults.
# How long a run parks on the approval before it expires (see docs/RECOMPUTE.md).
FPA_APPROVAL_TIMEOUT_HOURS=72
# Dirty rows per child workflow.
FPA_PARTITION_SIZE=200
# Commitment Service failure injection at start-up, 0.0-1.0. The runtime lever
# is POST localhost:8100/admin/failure-rate; this is only the initial value.
FPA_COMMITMENT_FAILURE_RATE=0
