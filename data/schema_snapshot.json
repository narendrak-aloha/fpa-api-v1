  "metrics": {
    "services_revenue": {
      "kind": "additive",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020','41400'))",
      "accounts": [
        "41000",
        "41010",
        "41020",
        "41400"
      ]
    },
    "delivery_cost": {
      "kind": "additive",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account IN ('51000','51050','51100','51300','51500'))",
      "accounts": [
        "51000",
        "51050",
        "51100",
        "51300",
        "51500"
      ]
    },
    "subcontractor_cost": {
      "kind": "additive",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account = '51100')",
      "accounts": [
        "51100"
      ]
    },
    "gross_margin": {
      "kind": "additive",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020','41400')) - sumIf({a}.amount_functional, {a}.account IN ('51000','51050','51100','51300','51500'))",
      "accounts": [
        "41000",
        "41010",
        "41020",
        "41400",
        "51000",
        "51050",
        "51100",
        "51300",
        "51500"
      ]
    },
    "utilisation": {
      "kind": "ratio",
      "sql_expression": "sumIf({a}.quantity, {a}.account IN ('41000','41010','41020')) / nullIf(sumIf({a}.quantity, {a}.account IN ('51000','51050','51400')), 0)"
    },
    "realisation": {
      "kind": "ratio",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020')) / nullIf(sumIf({a}.quantity, {a}.account IN ('41000','41010','41020')), 0)"
    },
    "gross_margin_pct": {
      "kind": "ratio",
      "sql_expression": "(sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020','41400')) - sumIf({a}.amount_functional, {a}.account IN ('51000','51050','51100','51300','51500'))) / nullIf(sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020','41400')), 0)"
    },
    "headcount": {
      "kind": "semi_additive",
      "sql_expression": "uniqExactIf({a}.resource_employee, {a}.resource_employee != '')"
    },
    "bookings": {
      "kind": "additive",
      "sql_expression": "sumIf({a}.amount_functional, {a}.account IN ('41000','41010','41020','41400'))",
      "accounts": [
        "41000",
        "41010",
        "41020",
        "41400"
      ]
    },
    "open_pipeline": {
      "kind": "semi_additive",
